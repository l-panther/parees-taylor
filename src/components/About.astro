---
import { asset } from '../utils/paths';
---

<!-- About -->
<section id="about" aria-labelledby="about-heading" class="section">
  <div class="container main-content">
    <div class="row">

      <!-- Text Column -->
      <div class="col-sm-12 col-lg-8">
        <h2 id="about-heading">About Parees</h2>
        <p>Parees has over 20 years of experience in the black hair industry.</p>

        <blockquote>
          "Inspired by my own experiences and customer feedback, I realised that buying quality hair weave can be a lottery. The quality is often compromised meaning textures vary from pack to pack. Parees Remi hair uses only the finest 100% Remi hair to ensure consistency in every pack. The hair is natural looking, easy to maintain, tangle-free, and available in different textures to suit all hair types."
        </blockquote>
      </div>

      <!-- Image Column -->
      <div class="col-sm-12 col-lg-4 text-center">
        <img src={asset{'assets/images/main/pareestaylor.jpg'}}
             alt="Portrait of Parees Taylor"
             title="Parees Taylor"
             class="responsive-img" />
      </div>
    </div>
  </div>
</section>
