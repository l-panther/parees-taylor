---
import "@splidejs/splide/dist/css/splide.min.css";
import { asset } from '../utils/paths';
---

<!-- Hero -->
<div id="hero">
  <div class="splide main-content" id="image-slider" aria-label="Image carousel showcasing different hair services">
    <div class="splide__track">
      <ul class="splide__list">
        <li class="splide__slide">
          <picture>
            <source media="(min-width: 650px)" srcset={asset{'assets/images/hero/styling-mid.jpg'}}>
            <source media="(min-width: 992px)" srcset={asset{'assets/images/hero/styling.jpg'}}>
            <img src={asset{'assets/images/hero/styling-small.jpg'}} alt="Hair styling options for different hair types" />
          </picture> 
        </li>
        <li class="splide__slide">
          <picture>
            <source media="(min-width: 650px)" srcset={asset{'assets/images/hero/remy-hair-mid.jpg'}}>
            <source media="(min-width: 992px)" srcset={asset{'assets/images/hero/remy-hair.jpg'}}>
            <img src={asset{'assets/images/hero/remy-hair-small.jpg'}} alt="100% Remy Hair styled" />
          </picture>
        </li>
        <li class="splide__slide">
          <picture>
            <source media="(min-width: 650px)" srcset={asset{'assets/images/hero/colour-mid.jpg'}}>
            <source media="(min-width: 992px)" srcset={asset{'assets/images/hero/colour.jpg'}}>
            <img src={asset{'assets/images/hero/colour-small.jpg'}} alt="Hair colour services" />
          </picture>
        </li>
        <li class="splide__slide">
          <picture>
            <source media="(min-width: 650px)" srcset={asset{'assets/images/hero/bridal-mid.jpg'}}>
            <source media="(min-width: 992px)" srcset={asset{'assets/images/hero/bridal.jpg'}}>
            <img src={asset{'assets/images/hero/bridal-small.jpg'}} alt="Bridal hair styling" />
          </picture>
        </li>
      </ul>
    </div>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>

<!-- Initialize Splide carousel -->
<script type="module">
  document.addEventListener('DOMContentLoaded', () => {
      // Initialize Splide slideshow
  new Splide('#image-slider', {
    type: 'loop',
    perPage: 1,
    autoplay: true,
    interval: 5000,
    pauseOnHover: true,
  }).mount();

  });
</script>
